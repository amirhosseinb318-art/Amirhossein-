# =============================================================================
# AI Crisis Radar — environment configuration
# Copy to .env.local (gitignored) or configure these in your host's dashboard.
# Never commit real secrets. Rotate anything that has been exposed.
# =============================================================================

# Public origin used for invitation links and CSRF origin checks.
APP_URL=http://localhost:3000

# 32+ random bytes, base64 or hex. Required outside demo mode.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# true  = local file store, synthetic demo data, demo accounts (local dev only)
# false = production mode; requires Supabase + a bootstrap admin
DEMO_MODE=true

# Seeded demo accounts (admin@demo.local / analyst@demo.local / viewer@demo.local)
# Only used when DEMO_MODE=true. Change it if you expose the demo publicly.
DEMO_SEED_PASSWORD=

# Bootstrap the first administrator (production). Created only when no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: override the local store directory (default: ./.data)
LOCAL_DATA_DIR=

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL + RLS) — recommended for production
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI analysis provider (server-side only)
# ---------------------------------------------------------------------------
# auto | openai | anthropic | none
# auto uses an OpenAI-compatible endpoint when AI_API_KEY is set, otherwise the
# labelled extractive fallback. Set none to force the fallback offline.
AI_PROVIDER=auto
AI_API_KEY=
# Any OpenAI-compatible base URL, e.g. https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Web Push (VAPID). Without these the UI clearly disables push delivery.
# Generate: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---------------------------------------------------------------------------
# Ingestion & scheduling
# ---------------------------------------------------------------------------
# Scheduler calls GET/POST /api/cron/ingest with: Authorization: Bearer <secret>
CRON_SECRET=
# Contact address placed in the collector User-Agent (required by many sources)
INGEST_USER_AGENT_CONTACT=ops@example.com
# Minimum interval between polls of the same source (ms). Default 5 minutes.
INGEST_MIN_INTERVAL_MS=300000
# Respect robots.txt for feed paths. Do not disable without explicit permission.
RESPECT_ROBOTS=true

# ---------------------------------------------------------------------------
# Alert safety policy (leave defaults unless you have reviewed the policy)
# Both flags are required to bypass human review for severity-4 alerts.
# Severity-5 alerts always require review.
# ---------------------------------------------------------------------------
ALERT_AUTO_APPROVE=false
ALERT_POLICY_TESTED=false

# Allow non-Secure cookies on http origins (local production testing only).
ALLOW_INSECURE_COOKIES=false
